{
  "name": "@astra/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the ASTRA FastAPI OpenAPI schema. Never hand-edited.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/api.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3"
  }
}
