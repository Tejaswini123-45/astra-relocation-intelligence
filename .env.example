# ASTRA — copy to .env for local development. NEVER commit a filled-in .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ASTRA_ENV=development                 # development | production
ASTRA_API_HOST=0.0.0.0
ASTRA_API_PORT=8000
ASTRA_DATA_DIR=./data                 # root of raw/ derived/ fixtures/
ASTRA_DB_PATH=./data/astra.sqlite     # mutable state: scenarios, runs, audit
ASTRA_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Fixture integrity gate (§4.5). Leave enabled; the API must refuse to start
# on invalid fixtures. Only ever disabled for debugging a broken dataset.
ASTRA_VALIDATE_FIXTURES_ON_STARTUP=true

# ---------------------------------------------------------------------------
# LLM narration layer (§10) — OPTIONAL BY DESIGN.
# With no key configured ASTRA runs the full demo using deterministic template
# narration. The LLM never computes, ranks, selects or overrides anything.
# ---------------------------------------------------------------------------
ASTRA_LLM_ENABLED=false
ASTRA_LLM_PROVIDER=anthropic          # anthropic | openai | none
ASTRA_LLM_MODEL=claude-sonnet-5
ASTRA_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The IPv4 loopback, not "localhost": the API binds IPv4, and on Windows
# "localhost" tries IPv6 first at a cost of ~200 ms per request.
NEXT_PUBLIC_ASTRA_API_URL=http://127.0.0.1:8000
